# NestJS API (Python FastAPI replacement)
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8765
ADMIN_PASSWORD=
SEO_DB_PATH=../../data/admin.db
# 학원 심층조사 전용 DB(admin.db와 분리 · 초기화되지 않음 · git 미추적)
ACADEMY_RESEARCH_DB_PATH=../../data/academy_research.db
PUBLIC_API_ORIGINS=*
WORKER_POLL_INTERVAL=3

# 이미지 생성 provider
# - OPENAI_API_KEY 를 넣으면 자동으로 공식 OpenAI 이미지 API(gpt-image-1)를 사용한다(대량 생성 권장).
# - 키가 없으면 기존 Codex(ChatGPT OAuth, ~/.codex/auth.json) 경로로 폴백한다.
# - SEO_IMAGE_PROVIDER 로 강제 지정 가능: openai | codex
OPENAI_API_KEY=
# SEO_IMAGE_PROVIDER=openai
# SEO_IMAGE_MODEL=gpt-image-1
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# 이미지 계측: 생성 이미지 1장당 추정 단가(USD). post.image_cost_usd = 생성장수 × 이 값.
# Codex 구독 경로는 0(무료), OpenAI API 경로면 실단가를 넣어 건당 비용을 계측한다(예: 0.04).
# SEO_IMAGE_PRICE_USD=0
