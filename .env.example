# Adrock 콘텐츠 운영 Nest API 환경변수 — 복사해서 .env 로 사용 (.env 는 gitignore 됨)

# --- 서버 ---
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8765
ADMIN_PASSWORD=            # 비우면 로컬 오픈, 운영에선 반드시 설정
API_WORKER=1               # 1이면 API 프로세스에서 job worker도 함께 실행
SEO_API_BASE_URL=http://127.0.0.1:8765

# --- 브랜드/콘텐츠 ---
SEO_BRAND_NAME=Adrock
SEO_QUALITY_MIN_TEXT_CHARS=1500
SEO_QUALITY_MAX_TEXT_CHARS=6500
SEO_QUALITY_MAX_ATTEMPTS=2

# --- DB (도커 볼륨 등으로 옮길 때) ---
# SEO_DB_PATH=/data/admin.db
# 학원 심층조사 전용 DB(admin.db와 분리 · 초기화되지 않음)
# ACADEMY_RESEARCH_DB_PATH=/data/academy_research.db

# --- 워커 ---
WORKER_POLL_INTERVAL=3

# --- 공개 API / 데이터 수신 ---
PUBLIC_API_ORIGINS=*               # 운영: 회사 도메인만 허용하도록 제한
PUBLIC_WRITE_TOKEN=                # 학원데이터 POST 보호(설정 시 token 또는 x-public-write-token 필요)

# --- 외부 원천 API 동기화(필요 시 회사 환경에 맞게 교체) ---
# 기본은 운영 endpoint 다. 한때 "수강료(educationPerformance)·셔틀(shuttleBuses)·운영시간(operateHour)·
# 면허 과정(licenseTypes)은 dev 에만 있다"고 적혀 있었으나 2026-07-27 실측 결과 운영에도 모두 열려 있다
# (운영 380곳 기준 수강료 331 · 셔틀 212 · 운영시간 256 · 면허 과정 336 — dev 와 동일 수준).
# 이 필드들은 글의 학원별 차별화(academy-distinguishing-points)의 유일한 재료이므로,
# 필드가 비는 endpoint 로 바꾸면 학원 소개가 다시 "상담 때 확인" 만 반복하게 된다.
DRIVINGPLUS_API_BASE_URL=https://api.drivingplus.me
# dev(테스트용): DRIVINGPLUS_API_BASE_URL=https://api-dev.drivingplus.me:18104
DRIVINGPLUS_API_TIMEOUT_MS=30000

# --- 색인(선택, 설정에서 UI로도 등록 가능) ---
# google_sa_json / indexing_url_template 은 app_settings(DB)에 저장

# 전 글유형 공통 문체. 기본은 독자에게 말을 거는 대화체다.
# formal 로 두면 기존 격식체 지침으로 되돌아간다("여러분" 등 2인칭 호칭도 다시 금지).
# 프로세스 시작 시점의 값을 읽으므로 바꾼 뒤에는 API 를 재시작해야 한다.
# SEO_PROMPT_STYLE=formal
