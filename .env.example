# Adrock 콘텐츠 운영 Nest API 환경변수 — 복사해서 .env 로 사용 (.env 는 gitignore 됨)
#
# ⚠️ 주석은 반드시 **줄 앞**에 쓴다. 값 뒤에 `VALUE   # 설명` 으로 붙이면 Docker 가 깨진다 —
# dev.sh 는 셸로 읽어 `#` 뒤를 버리지만 docker compose 의 env_file 파서는 그 문장까지 값으로
# 삼는다. 실제로 ADMIN_PASSWORD 가 "# 비우면 로컬 오픈..." 이 되어 관리자 API 가 그 문장을
# 토큰으로 요구했고(프록시 토큰과 불일치 → 전부 401), PUBLIC_API_ORIGINS 도 `*` 와 달라져
# CORS 매칭이 깨졌다. 같은 .env 를 host 는 정상, Docker 는 고장으로 읽는 구조였다.

# --- 서버 ---
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8765
# 비우면 로컬 오픈, 운영에선 반드시 설정
ADMIN_PASSWORD=
# 1이면 API 프로세스에서 job worker도 함께 실행
API_WORKER=1
SEO_API_BASE_URL=http://127.0.0.1:8765

# --- 브랜드/콘텐츠 ---
SEO_BRAND_NAME=Adrock
SEO_QUALITY_MIN_TEXT_CHARS=1500
SEO_QUALITY_MAX_TEXT_CHARS=6500
SEO_QUALITY_MAX_ATTEMPTS=2

# 후보(슬롯) 생성의 글유형당 상한(기본 10000). 한 번의 생성 실행이 만드는 행 수 상한이며
# DB 누적 총량 상한이 아니다 — 생성은 upsert 만 하고 기존 슬롯 수를 세지 않는다.
# 지역형은 이 값을 지역 수로 나눠 배분하므로 「지역당 후보 수 = 이 값 ÷ 지역 수」가 된다.
# 실측(지역 251곳): 10000 → 지역당 40개·71ms, 30000 → 119개·184ms, 100000 → 651ms.
# 생성 중에는 SQLite 동기 삽입이라 그 시간만큼 API 가 멈춘다. 프로세스 시작 시점에 읽는다.
# SEO_MAX_SLOTS_PER_TEMPLATE=10000

# --- DB (도커 볼륨 등으로 옮길 때) ---
# SEO_DB_PATH=/data/admin.db
# 학원 심층조사 전용 DB(admin.db와 분리 · 초기화되지 않음)
# ACADEMY_RESEARCH_DB_PATH=/data/academy_research.db

# --- 워커 ---
WORKER_POLL_INTERVAL=3

# --- 공개 API / 데이터 수신 ---
# 운영: 회사 도메인만 허용하도록 제한
PUBLIC_API_ORIGINS=*
# 학원데이터 POST 보호(설정 시 token 또는 x-public-write-token 필요)
PUBLIC_WRITE_TOKEN=

# --- 외부 원천 API 동기화(필요 시 회사 환경에 맞게 교체) ---
# 기본은 운영 endpoint 다. 한때 "수강료(educationPerformance)·셔틀(shuttleBuses)·운영시간(operateHour)·
# 면허 과정(licenseTypes)은 dev 에만 있다"고 적혀 있었으나 2026-07-27 실측 결과 운영에도 모두 열려 있다
# (운영 380곳 기준 수강료 331 · 셔틀 212 · 운영시간 256 · 면허 과정 336 — dev 와 동일 수준).
# 이 필드들은 글의 학원별 차별화(academy-distinguishing-points)의 유일한 재료이므로,
# 필드가 비는 endpoint 로 바꾸면 학원 소개가 다시 "상담 때 확인" 만 반복하게 된다.
DRIVINGPLUS_API_BASE_URL=https://api.drivingplus.me
# dev(테스트용): DRIVINGPLUS_API_BASE_URL=https://api-dev.drivingplus.me:18104
DRIVINGPLUS_API_TIMEOUT_MS=30000
# 블로그리뷰 수집 스위치(기본 꺼짐). 원천이 네이버 블로그 검색으로 학원명을 느슨하게 매칭해
# 다른 학원 글이 섞인다(2026-07-27 실측 539건 중 55건은 학원 고유명이 글에 없고, 같은 글 18건이
# 이름이 비슷한 학원 2~3곳에 중복 배정). 글 생성에도 쓰지 않는다. 블로그 글을 검증해 올바른
# 것만 쓰는 방법이 정해지면 켠다. 이미 수집된 자료는 켜고 끄는 것과 무관하게 보존된다.
# DRIVINGPLUS_BLOG_REVIEW_SYNC=1

# --- 색인(선택, 설정에서 UI로도 등록 가능) ---
# google_sa_json / indexing_url_template 은 app_settings(DB)에 저장

# 전 글유형 공통 문체. 기본은 독자에게 말을 거는 대화체다.
# formal 로 두면 기존 격식체 지침으로 되돌아간다("여러분" 등 2인칭 호칭도 다시 금지).
# 프로세스 시작 시점의 값을 읽으므로 바꾼 뒤에는 API 를 재시작해야 한다.
# SEO_PROMPT_STYLE=formal
