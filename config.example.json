{
  "server": { "host": "127.0.0.1", "port": 8787 },
  "dbPath": "data/writer.db",
  "llm": {
    "order": ["codex", "claude"],
    "timeoutSec": 600,
    "pauseAtUsagePercent": 80,
    "limitCooldownMin": 60,
    "codex": { "command": "codex", "model": "" },
    "claude": { "command": "claude", "model": "" }
  },
  "pacing": {
    "minIntervalSec": 300,
    "maxIntervalSec": 900,
    "dailyLimit": 10
  },
  "worker": { "pollSec": 5 },
  "keywords": {
    "minMonthlyVolume": 30,
    "maxTopicsPerSection": 50,
    "clusterThreshold": 0.5,
    "trendTopN": 30
  },
  "naver": {
    "searchadEnvFile": "~/.naver-searchad.env",
    "datalabClientId": "",
    "datalabClientSecret": ""
  },
  "sources": {
    "profile": "prod",
    "drivingplusApi": "",
    "drivingzoneApi": "",
    "cacheTtlHours": 24,
    "timeoutSec": 60
  }
}
